<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="dev.sinty.desktop" path="/dev/sinty/desktop/">
    <key name="wallpaper-favorites" type="as"><default>[]</default></key>
    <key name="wallpaper-effect" type="s">
      <choices>
        <choice value="none"/>
        <choice value="grayscale"/>
        <choice value="blur"/>
      </choices>
      <default>'none'</default>
    </key>
    <key name="wallpaper-effect-blur-radius" type="i">
      <range min="1" max="64"/>
      <default>8</default>
    </key>
    <key name="wallpaper-rotation-min-width" type="i"><range min="1" max="16384"/><default>1280</default></key>
    <key name="wallpaper-rotation-min-height" type="i"><range min="1" max="16384"/><default>720</default></key>
    <key name="wallpaper-rotation-match-aspect" type="b"><default>false</default></key>
    <key name="wallpaper-rotation-favor-favorites" type="b"><default>true</default></key>
    <key name="animated-icons" type="b"><default>true</default></key>
    <key name="form-factor" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="desktop"/>
        <choice value="tablet"/>
        <choice value="phone"/>
        <choice value="tv"/>
        <choice value="watch"/>
      </choices>
      <default>'auto'</default>
      <summary>Form factor</summary>
      <description>How the shell and Singularity apps present themselves: desktop, tablet, phone, TV or watch. Auto keeps the desktop.</description>
    </key>
    <key name="output-form-factors" type="a{ss}">
      <default>{}</default>
      <summary>Form factor of each screen</summary>
      <description>Maps a screen connector (for example HDMI-A-1) to how that screen behaves: desktop, tablet, phone, tv or watch. Screens not listed are detected from their size; the main screen follows form-factor.</description>
    </key>
  </schema>
</schemalist>
